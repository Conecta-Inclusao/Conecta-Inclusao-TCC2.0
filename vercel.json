{
  "version": 2,
  "builds": [
    {
      "src": "conecta-inclusao-front/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/conecta-inclusao-front/src/pages/lndex.html"
    },
    {
      "src": "/index.html",
      "dest": "/conecta-inclusao-front/src/pages/lndex.html"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/conecta-inclusao-front/src/pages/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/conecta-inclusao-front/src/assets/$1"
    }
  ]
}
