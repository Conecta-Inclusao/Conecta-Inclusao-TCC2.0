# Copie para .env e preencha. NUNCA versione o .env.

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL / Neon)
# A connection string do Neon ja vem com ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# JWT - obrigatorio, minimo 32 caracteres.
# A API nao sobe sem esta variavel (antes havia um fallback hardcoded).
# Gere um segredo novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1h
TEMP_PASSWORD_RESET_EXPIRES_IN=15m

# ---------------------------------------------------------------------------
# Politica de login
# ---------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=5
PASSWORD_RESET_MINUTES=30

# ---------------------------------------------------------------------------
# Front-end
# FRONTEND_BASE_URL monta o link de recuperacao de senha.
# CORS_ORIGINS e a allowlist de origens (separadas por virgula). Se vazio, em
# desenvolvimento libera localhost e em producao usa FRONTEND_BASE_URL.
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# E-mail - usado na recuperacao de senha
#
# Com MAILJET_API_KEY preenchida o envio sai pela API HTTP do Mailjet (porta
# 443). Isso e obrigatorio em producao no Render: o plano free bloqueia trafego
# de saida nas portas SMTP (25, 465 e 587), e o envio estoura em ETIMEDOUT.
# As duas chaves ficam em Account settings > API Key Management.
# MAILJET_SENDER precisa ser um remetente verificado no painel do Mailjet; se
# ficar vazio, o codigo usa SMTP_FROM.
# ---------------------------------------------------------------------------
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER="Conecta Inclusao <seu_email@exemplo.com>"

# ---------------------------------------------------------------------------
# Fallback SMTP (Nodemailer) - usado quando MAILJET_API_KEY esta vazia.
# Serve para rodar a API localmente com o Gmail.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Conecta Inclusao <seu_email@exemplo.com>"
